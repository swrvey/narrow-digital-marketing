{#
  ============================================================================
  CTA BAND — the dark "let's talk" block above the footer.
  Included at the bottom of every page. Edit the copy here once.
  ============================================================================
#}
<section class="section section--dark cta">
  <div class="wrap" data-reveal-group>

    <h2 class="reveal">Let&rsquo;s talk about your next job<span class="diamond" aria-hidden="true"></span></h2>

    <p class="lede reveal">
      Tell me what you do and where you work. I&rsquo;ll tell you honestly whether I can help.
    </p>

    <div class="cta__actions reveal">
      <a class="btn" href="/contact/">Start a project</a>
      <a class="cta__mail" href="mailto:{{ site.email }}">{{ site.email }}</a>
    </div>

  </div>
</section>
