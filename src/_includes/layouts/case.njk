---
layout: layouts/base.njk
---
{#
  ============================================================================
  CASE STUDY LAYOUT — the frame around every project page.
  The project's own file supplies: client, tag, year, scope, cover, coverAlt,
  and the body content. You should not need to edit this file to add a project.
  ============================================================================
#}

<!-- ============ PROJECT HERO ============ -->
<section class="page-hero">
  <div class="wrap" data-reveal-group>
    <span class="eyebrow reveal">
      <a href="/work/" style="text-decoration:none;color:inherit;">Work</a> &mdash; {{ tag }}
    </span>
    <h1 class="reveal" style="margin-top:1rem;">{{ client }}<span class="diamond" aria-hidden="true"></span></h1>
    <p class="lede reveal">{{ summary }}</p>
  </div>
</section>

<!-- ============ COVER IMAGE ============ -->
<section class="wrap">
  <div class="work-card__media reveal">
    <img src="{{ cover }}"
         srcset="{{ coverSmall }} 800w, {{ cover }} 1600w"
         sizes="(min-width: 1280px) 1200px, 92vw"
         alt="{{ coverAlt }}" width="1600" height="1000">
  </div>
</section>

<!-- ============ PROJECT FACTS ============ -->
<section class="section section--tight">
  <div class="wrap">
    <div class="split split--sticky" data-reveal-group>

      <div class="reveal">
        <ul class="facts" style="margin-top:0;">
          <li><span class="facts__k">Client</span> <span class="facts__v">{{ client }}</span></li>
          <li><span class="facts__k">Year</span> <span class="facts__v">{{ year }}</span></li>
          <li><span class="facts__k">Scope</span> <span class="facts__v">{{ scope }}</span></li>
          {# Only appears if the project file sets `website`. Shows the domain
             rather than the word "Visit" — people click a name they recognise. #}
          {% if website %}
            <li>
              <span class="facts__k">Live site</span>
              <span class="facts__v">
                <a class="link" href="{{ website }}" target="_blank" rel="noopener">
                  {{ websiteLabel or website | replace("https://", "") | replace("http://", "") }}
                  <span aria-hidden="true">&nearr;</span>
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </span>
            </li>
          {% endif %}
        </ul>
      </div>

      <div class="reveal">
        {{ content | safe }}
      </div>

    </div>
  </div>
</section>

<!-- ============ BACK TO WORK ============ -->
<section class="section section--tight">
  <div class="wrap">
    <hr class="divider">
    <p class="mt-4"><a class="link-arrow" href="/work/">All work <span aria-hidden="true">&rarr;</span></a></p>
  </div>
</section>

{% include "partials/cta.njk" %}
